      <!-- 3. GERADOR DE LAUDO VIBRACIONAL COM IA (GEMINI 2.5 FLASH VIA GOOGLE APPS SCRIPT) -->
      <div class="cosmic-card p-6 rounded-2xl border-gold-500/40">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="text-lg">✨</span>
