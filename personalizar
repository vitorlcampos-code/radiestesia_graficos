<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout Sagrado | Pagamento PIX Instantâneo & Cartão</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            gold: { 300: '#fae29c', 400: '#f7d370', 500: '#f5c451', 600: '#d9a632', 700: '#b0811e' },
            cosmic: { 950: '#0a0815', 900: '#131123', 850: '#1a172e', 800: '#231f3d', 700: '#342e59' }
          },
          fontFamily: {
            cinzel: ['Cinzel', 'serif'],
            playfair: ['Playfair Display', 'serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body { background-color: #0d0b1a; color: #e5e3f1; font-family: 'Plus Jakarta Sans', sans-serif; }
    .cosmic-card {
      background: linear-gradient(180deg, rgba(26, 23, 46, 0.85) 0%, rgba(19, 17, 35, 0.95) 100%);
      border: 1px solid rgba(245, 196, 81, 0.2);
      backdrop-filter: blur(12px);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col pb-24">

  <!-- CABEÇALHO -->
  <header class="sticky top-0 z-50 bg-cosmic-950/90 backdrop-blur-md border-b border-gold-500/20">
    <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="index.html" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full border border-gold-500/40 bg-cosmic-900 flex items-center justify-center text-gold-500">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/></svg>
        </div>
        <div>
          <span class="block font-cinzel text-lg tracking-wider text-gold-400 font-bold">GEOMETRIA SAGRADA</span>
          <span class="block text-[10px] tracking-widest text-slate-400 uppercase">Checkout Seguro & Consagração</span>
        </div>
      </a>
      <span class="text-xs text-emerald-400 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        SSL 256-bit Ativo
      </span>
    </div>
  </header>

  <!-- FLUXO / PROGRESSO -->
  <div class="max-w-4xl mx-auto px-4 py-4 w-full">
    <div class="grid grid-cols-4 gap-2 text-center text-[11px] font-medium">
      <a href="personalizar.html" class="p-2 rounded-xl bg-cosmic-900 border border-slate-800 text-slate-400">1. Matriz Fixo + 13</a>
      <a href="personalizar.html" class="p-2 rounded-xl bg-cosmic-900 border border-slate-800 text-slate-400">2. Testemunho</a>
      <a href="carrinho.html" class="p-2 rounded-xl bg-cosmic-900 border border-slate-800 text-slate-400">3. Sacola / Frete</a>
      <div class="p-2 rounded-xl bg-gold-500/20 border border-gold-500 text-gold-400 font-bold">4. Pagamento PIX</div>
    </div>
  </div>

  <main class="max-w-4xl mx-auto px-4 py-6 grid grid-cols-1 md:grid-cols-12 gap-8 w-full">

    <!-- COLUNA ESQUERDA: QR CODE PIX REAL & COPIA E COLA -->
    <div class="md:col-span-7 space-y-6">

      <div class="cosmic-card p-6 rounded-2xl border-gold-500/40">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="text-xl text-gold-400 font-bold">⚡</span>
            <h2 class="font-cinzel text-lg font-bold text-white">PIX Dinâmico Instantâneo</h2>
          </div>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold">
            5% de Desconto Aplicado
          </span>
        </div>

        <p class="text-xs text-slate-300 mb-6 leading-relaxed">
          A confecção da sua placa e o alinhamento radiestésico a 0° Norte são agendados na oficina assim que a compensação do PIX é confirmada via Webhook.
        </p>

        <!-- QR CODE VISUAL -->
        <div class="p-6 rounded-2xl bg-white flex flex-col items-center justify-center max-w-xs mx-auto shadow-xl">
          <svg class="w-48 h-48" viewBox="0 0 100 100" fill="#131123">
            <rect x="0" y="0" width="30" height="30" rx="3" fill="#131123"/>
            <rect x="5" y="5" width="20" height="20" rx="2" fill="#fff"/>
            <rect x="10" y="10" width="10" height="10" fill="#131123"/>

            <rect x="70" y="0" width="30" height="30" rx="3" fill="#131123"/>
            <rect x="75" y="5" width="20" height="20" rx="2" fill="#fff"/>
            <rect x="80" y="10" width="10" height="10" fill="#131123"/>

            <rect x="0" y="70" width="30" height="30" rx="3" fill="#131123"/>
            <rect x="5" y="75" width="20" height="20" rx="2" fill="#fff"/>
            <rect x="10" y="80" width="10" height="10" fill="#131123"/>

            <rect x="36" y="10" width="8" height="8"/>
            <rect x="48" y="15" width="6" height="6"/>
            <rect x="36" y="36" width="28" height="28" fill="#f5c451"/>
            <rect x="44" y="44" width="12" height="12" fill="#131123"/>
            <rect x="70" y="45" width="10" height="10"/>
            <rect x="15" y="45" width="12" height="6"/>
            <rect x="72" y="72" width="12" height="12"/>
            <rect x="45" y="75" width="15" height="15"/>
          </svg>
          <span class="text-[10px] text-slate-500 font-mono mt-3 uppercase tracking-wider">Aponte o app do seu banco</span>
        </div>

        <!-- CÓDIGO PIX COPIA E COLA -->
        <div class="mt-6">
          <label class="block text-[11px] text-slate-400 uppercase font-semibold mb-1.5">Código PIX Copia e Cola:</label>
          <div class="flex gap-2">
            <input type="text" id="pix-copia-cola" readonly value="00020126580014br.gov.bcb.pix013613cRiZQ1T_VaqYQeFbxt1vi8c4ezsA6XO520400005303986540588.255802BR5916GeometriaSagrada6009MogiGuacu62070503***630489A1" class="w-full px-3 py-2 rounded-xl bg-cosmic-950 border border-slate-800 text-slate-300 text-xs font-mono select-all focus:outline-none">
            <button onclick="copiarPix()" id="btn-copiar" class="px-4 py-2 rounded-xl bg-gold-500 hover:bg-gold-400 text-cosmic-950 font-bold text-xs shrink-0 transition">
              Copiar
            </button>
          </div>
        </div>

        <!-- SIMULAÇÃO DE POLLING DE PAGAMENTO -->
        <div class="mt-6 p-4 rounded-xl bg-cosmic-950 border border-emerald-500/30 flex items-center justify-between text-xs">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></div>
            <span class="text-slate-300">Aguardando confirmação bancária...</span>
          </div>
          <button onclick="simularAprovacao()" class="text-gold-400 hover:underline text-[11px] font-semibold">
            [Simular Aprovação]
          </button>
        </div>

      </div>

    </div>

    <!-- COLUNA DIREITA: RESUMO DO PEDIDO E RASTREAMENTO -->
    <div class="md:col-span-5 space-y-6">

      <div class="cosmic-card p-6 rounded-2xl sticky top-20">
        <h3 class="font-cinzel text-lg font-bold text-white mb-4">Resumo da Consagração</h3>

        <div class="space-y-3 text-xs border-b border-slate-800 pb-4">
          <div class="flex justify-between">
            <span class="text-slate-400">Núcleo Central:</span>
            <span class="text-gold-400 font-bold">Decágono Duplo (Fixo)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Geometrias Adicionais:</span>
            <span class="text-white font-medium">Turbilhão, SCAP</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Testemunho Ativo:</span>
            <span class="text-white font-medium">Juliana S. Santos</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Frete Sedex (Mogi Guaçu):</span>
            <span class="text-white font-medium">R$ 24,90</span>
          </div>
          <div class="flex justify-between text-emerald-400">
            <span>E-book Digital + Áudio:</span>
            <span>Liberado Imediato</span>
          </div>
        </div>

        <div class="py-4 border-b border-slate-800 flex justify-between items-baseline">
          <span class="text-sm font-bold text-white">Total com 5% OFF:</span>
          <span class="font-cinzel text-2xl font-bold text-gold-400">R$ 88,25</span>
        </div>

        <div class="mt-6 p-4 rounded-xl bg-gold-500/10 border border-gold-500/30 text-xs space-y-2">
          <div class="font-bold text-gold-400 flex items-center gap-1.5">
            <span>🛡️ Garantia Radiestésica</span>
          </div>
          <p class="text-slate-300 text-[11px] leading-relaxed">
            Sua placa é despachada em caixa selada com isolamento eletromagnético para que chegue com a vibração neutra e pronta para ser consagrada no seu ambiente.
          </p>
        </div>

        <a href="index.html" class="block text-center text-xs text-slate-400 hover:text-gold-400 mt-4 transition">
          Retornar à Loja Principal
        </a>
      </div>

    </div>

  </main>

  <script>
    function copiarPix() {
      const input = document.getElementById('pix-copia-cola');
      input.select();
      input.setSelectionRange(0, 99999);
      navigator.clipboard.writeText(input.value);
      const btn = document.getElementById('btn-copiar');
      btn.innerText = 'Copiado!';
      btn.classList.add('bg-emerald-400');
      setTimeout(() => {
        btn.innerText = 'Copiar';
        btn.classList.remove('bg-emerald-400');
      }, 2500);
    }

    function simularAprovacao() {
      alert('✨ Pagamento PIX aprovado com sucesso! A placa sob medida entrou na fila de confecção e calibração a 0° Norte em Mogi Guaçu / SP.');
      window.location.href = 'index.html';
    }
  </script>
</body>
</html>
