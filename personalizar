  <!-- SCRIPT DE THREE.JS E INTEGRAÇÃO DO GOOGLE APPS SCRIPT -->
  <script>
    // URL OFICIAL DA SUA IMPLANTAÇÃO NO GOOGLE APPS SCRIPT
    const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyqMA0OB264jrzYr7xuiFdbTmDJba7yI87Pp_gKrt5uvtXepXQlADuMzH3pLFJqps-_/exec';

    let selecionados = ["Turbilhão Prosperador", "SCAP Compensador"];

    function atualizarGeometrias(checkbox) {
      if (checkbox.checked) {
        if (selecionados.length >= 13) {
          alert('Limite máximo de 13 geometrias adicionais atingido para garantir a ressonância sem interferência destrutiva.');
          checkbox.checked = false;
          return;
        }
        selecionados.push(checkbox.value);
      } else {
        selecionados = selecionados.filter(item => item !== checkbox.value);
      }
      document.getElementById('contador-graficos').innerText = `${selecionados.length} / 13 Adicionais`;
    }

    function sincronizarTestemunho() {
      const nome = document.getElementById('campo-nome').value;
      document.getElementById('label-testemunho').innerText = nome || 'Testemunho Ativo';
    }

    // CHAMADA REAL À API DO APPS SCRIPT (GEMINI 2.5 FLASH)
    async function gerarLaudoAppsScript() {
      const btn = document.getElementById('btn-ia');
      const editor = document.getElementById('editor-laudo');
      const intencao = document.getElementById('campo-intencao').value;
      const nome = document.getElementById('campo-nome').value;

      btn.innerHTML = '✨ Conectando ao Gemini 2.5 Flash...';
      btn.disabled = true;

      try {
        const payload = {
          action: 'GERAR_LAUDO',
          intencao: `Testemunho: ${nome}. Intenção: ${intencao}`,
          graficos: ["Decágono Duplo (Centro Fixo)", ...selecionados]
        };

        const response = await fetch(APPS_SCRIPT_URL, {
          method: 'POST',
          body: JSON.stringify(payload)
        });

        const data = await response.json();
        if (data.status === 'success' && data.laudo) {
          editor.value = data.laudo;
        } else {
          editor.value = "1. DIAGNÓSTICO: O Decágono central atua na despolarização rápida de miomas energéticos.\n2. FREQUÊNCIA: 528 Hz.\n3. ATIVAÇÃO: Manter alinhado a 0° Norte por 14 dias.";
        }
      } catch (err) {
        console.warn('Fallback offline para laudo:', err);
        editor.value = `1. DIAGNÓSTICO ENERGÉTICO (${nome}):\nA ativação do Decágono Duplo central com ${selecionados.join(' e ')} estabelece um canal harmônico de proteção e abertura de caminhos.\n2. FREQUÊNCIA: 528 Hz.\n3. RECOMENDAÇÃO: Deixar em repouso ao Norte por 21 dias.`;
      } finally {
        btn.innerHTML = '✨ Regenerar Laudo com IA';
        btn.disabled = false;
      }
    }

    function avancarParaCarrinho() {
      const dados = {
        nucleoFixo: "Decágono Duplo",
        geometriasAdicionais: selecionados,
        testemunho: {
          nome: document.getElementById('campo-nome').value,
          nascimento: document.getElementById('campo-nasc').value,
          intencao: document.getElementById('campo-intencao').value
        },
        laudoIA: document.getElementById('editor-laudo').value,
        valorPlaca: 68.00
      };
      localStorage.setItem('geometria_pedido_v2', JSON.stringify(dados));
      window.location.href = 'carrinho.html';
    }

    // INICIALIZAÇÃO DO THREE.JS (VISUALIZADOR 3D DA PLACA)
    (function initThree() {
      const container = document.getElementById('three-container');
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
      camera.position.set(0, 0, 9);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(window.devicePixelRatio || 1);
      container.appendChild(renderer.domElement);

      const group = new THREE.Group();
      scene.add(group);

      // Decágono Duplo Central
      for (let r = 2.0; r <= 2.3; r += 0.3) {
        const points = [];
        for (let i = 0; i <= 10; i++) {
          const theta = (i / 10) * Math.PI * 2;
          points.push(new THREE.Vector3(Math.cos(theta) * r, Math.sin(theta) * r, 0));
        }
        const geom = new THREE.BufferGeometry().setFromPoints(points);
        const mat = new THREE.LineBasicMaterial({ color: 0xf5c451, linewidth: 2 });
        group.add(new THREE.Line(geom, mat));
      }

      // Círculos concêntricos de emanação
      for (let r = 2.8; r <= 3.8; r += 0.5) {
        const circleGeom = new THREE.RingGeometry(r, r + 0.02, 64);
        const circleMat = new THREE.MeshBasicMaterial({ color: 0x9382d6, side: THREE.DoubleSide });
        group.add(new THREE.Mesh(circleGeom, circleMat));
      }

      function animate() {
        requestAnimationFrame(animate);
        group.rotation.z += 0.003;
        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      });
    })();
  </script>
</body>
