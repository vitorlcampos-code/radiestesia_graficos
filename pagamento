<script>
  function switchTab(tabKey) {
    const pixContent = document.getElementById('content-pix');
    const cardContent = document.getElementById('content-card');
    const boletoContent = document.getElementById('content-boleto');

    const pixBtn = document.getElementById('tab-pix-btn');
    const cardBtn = document.getElementById('tab-card-btn');
    const boletoBtn = document.getElementById('tab-boleto-btn');
    const ctaLabel = document.getElementById('cta-label');

    // Reset All Tabs styling
    const defaultClasses = "flex-1 py-2.5 px-2 rounded-lg bg-surface-container-low text-on-surface-variant hover:text-on-surface font-label-lg text-label-lg flex flex-col items-center justify-center transition-all";
    const activeClasses = "flex-1 py-2.5 px-2 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-bold flex flex-col items-center justify-center transition-all shadow-[0_0_14px_rgba(245,196,81,0.35)]";

    pixBtn.className = defaultClasses;
    cardBtn.className = defaultClasses;
    boletoBtn.className = defaultClasses;

    pixContent.classList.add('hidden');
    cardContent.classList.add('hidden');
    boletoContent.classList.add('hidden');
    pixContent.classList.remove('flex');
    cardContent.classList.remove('flex');
    boletoContent.classList.remove('flex');

    if (tabKey === 'pix') {
      pixBtn.className = activeClasses;
      pixContent.classList.remove('hidden');
      pixContent.classList.add('flex');
      ctaLabel.textContent = "Já Efetuei o Pagamento PIX";
    } else if (tabKey === 'card') {
      cardBtn.className = activeClasses;
      cardContent.classList.remove('hidden');
      cardContent.classList.add('flex');
      ctaLabel.textContent = "Pagar R$ 108,60 no Cartão";
    } else if (tabKey === 'boleto') {
      boletoBtn.className = activeClasses;
      boletoContent.classList.remove('hidden');
      boletoContent.classList.add('flex');
      ctaLabel.textContent = "Gerar Boleto Sagrado";
    }
  }

  function copyPixCode() {
    const input = document.getElementById('pix-code-input');
    const toast = document.getElementById('copy-toast');
    const copyText = document.getElementById('copy-text');
    const copyIcon = document.getElementById('copy-icon');

    navigator.clipboard.writeText(input.value).then(() => {
      copyText.textContent = "Copiado!";
      copyIcon.textContent = "done";
      toast.classList.remove('hidden');

      setTimeout(() => {
        copyText.textContent = "Copiar";
        copyIcon.textContent = "content_copy";
        toast.classList.add('hidden');
      }, 3500);
    });
  }

  function confirmPaymentAction() {
    const btn = document.getElementById('main-cta-btn');
    btn.innerHTML = `<span class="material-symbols-outlined text-[20px] animate-spin">cyclone</span> Sintonizando Frequência...`;
    btn.disabled = true;

    setTimeout(() => {
      btn.innerHTML = `<span class="material-symbols-outlined text-[20px]">check_circle</span> Pagamento Detectado com Êxito!`;
      btn.classList.remove('from-primary-container', 'to-primary');
      btn.classList.add('bg-tertiary-container', 'text-on-tertiary-container');
    }, 1800);
  }

  // Timer simulado de 15 minutos
  let totalSeconds = 14 * 60 + 48;
  const timerElem = document.getElementById('pix-countdown');
  setInterval(() => {
    if (totalSeconds > 0) {
      totalSeconds--;
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      timerElem.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')} min`;
    }
  }, 1000);
